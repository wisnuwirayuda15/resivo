# Copy this file to `.env` and fill in the values.
# Only variables prefixed with VITE_ are exposed to the client bundle.

# Public app metadata
VITE_APP_NAME=Resivo

# Resivo is local-first: there is no backend, no account and no sync, so there
# is deliberately no API URL here. All user data lives in IndexedDB on the
# device. If you find yourself needing to add one, that is a design change.

# The address this deployment is reached at, such as https://resivo.example.
# Used for canonical and hreflang links, the sitemap and the absolute links in
# the documentation's Markdown. Optional: without it the address of the incoming
# request is used, which is right locally and behind a proxy that forwards the
# real host. Set it in production, because a Host header is chosen by whoever
# sends the request.
SITE_URL=

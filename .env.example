# Copy this file to `.env` and fill in the values.
# Only variables prefixed with VITE_ are exposed to the client bundle.

# Public app metadata
VITE_APP_NAME=Resivo

# Resivo is local-first: there is no backend, no account and no sync, so there
# is deliberately no API URL here. All user data lives in IndexedDB on the
# device. If you find yourself needing to add one, that is a design change.

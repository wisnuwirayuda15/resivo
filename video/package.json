{
  "name": "resivo-video",
  "private": true,
  "type": "module",
  "scripts": {
    "audio": "node scripts/generate-audio.mjs",
    "audio:check": "node scripts/check-audio.mjs",
    "dev": "remotion studio src/index.ts --port=3300",
    "studio": "bun run dev",
    "still": "remotion still src/index.ts Promo",
    "render": "bun run audio && remotion render src/index.ts Promo out/resivo-promo.mp4",
    "publish": "bun run render && node scripts/publish.mjs && remotion still src/index.ts Promo ../public/promo/resivo-promo.jpg --frame=444 --image-format=jpeg --jpeg-quality=88 --scale=0.667",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "@mantine/core": "9.5.1",
    "@mantine/hooks": "9.5.1",
    "@phosphor-icons/react": "2.1.10",
    "@remotion/cli": "4.0.533",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.23",
    "github-slugger": "^2.0.0",
    "i18next": "^26.4.2",
    "immer": "^11.1.21",
    "mdast-util-directive": "^3.1.1",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-to-markdown": "^2.2.0",
    "postcss": "^8.5.29",
    "postcss-safe-parser": "^7.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remotion": "4.0.533",
    "tailwind-merge": "^3.7.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^6.0.2"
  }
}
